{
  "name": "@johnmorrisdotca/meigen-sports",
  "version": "0.27.0",
  "description": "Meigen Sports 名言 — Sports quotations and on-this-day history for JavaScript: source-verified, typed offline data and pure date, sport and entity selectors, with static JSON feeds. One small runtime dependency.",
  "keywords": [
    "sports",
    "quotes",
    "quotations",
    "sports-history",
    "on-this-day",
    "olympics",
    "boxing",
    "wrestling",
    "static-api",
    "open-data",
    "typescript",
    "javascript",
    "browser",
    "node",
    "itsutsu"
  ],
  "homepage": "https://johnmorrisdotca.github.io/meigen-sports/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/meigen-sports.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/meigen-sports/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js",
      "default": "./dist/load.js"
    },
    "./quotes": {
      "types": "./dist/data/quotes.d.ts",
      "import": "./dist/data/quotes.js",
      "default": "./dist/data/quotes.js"
    },
    "./offline": {
      "types": "./dist/data/offline.d.ts",
      "import": "./dist/data/offline.js",
      "default": "./dist/data/offline.js"
    },
    "./history": {
      "types": "./dist/data/history.d.ts",
      "import": "./dist/data/history.js",
      "default": "./dist/data/history.js"
    },
    "./catalogue.json": "./data/v1/0.1.0/catalogue.json",
    "./package.json": "./package.json",
    "./categories": {
      "types": "./dist/categories.d.ts",
      "import": "./dist/categories.js",
      "default": "./dist/categories.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "data/v1/latest.json",
    "data/v1/0.1.0/all.json",
    "data/v1/0.1.0/history.json",
    "data/v1/0.1.0/quotes.json",
    "data/v1/0.1.0/manifest.json",
    "data/v1/0.1.0/catalogue.json",
    "data/v1/0.1.0/days",
    "data/v1/0.1.0/sports",
    "data/v1/0.1.0/entities",
    "LICENSE",
    "LICENSES",
    "NOTICE.md",
    "CHANGELOG.md",
    "README.md",
    "data-sources/sources.json",
    "data-sources/README.md",
    "styles.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.demo.json",
    "test": "node scripts/ensure-shards.ts && node --test test/*.test.ts",
    "check": "pnpm shards && pnpm lint && pnpm typecheck && pnpm check:lines && pnpm test && pnpm build && node scripts/check-package.ts",
    "test:package": "pnpm build && node scripts/check-package.ts",
    "test:golden": "node scripts/check-golden.ts",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "test:usage": "pnpm site && node scripts/check-usage.ts",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "check:standard": "node scripts/check-standard.mjs",
    "check:lines": "node scripts/check-max-lines.mjs",
    "prepublishOnly": "pnpm check",
    "family:readme": "node scripts/family-readme.mjs",
    "data": "node scripts/data.ts",
    "data:report": "node scripts/data.ts --report",
    "data:check": "node scripts/data.ts --check",
    "data:days": "node scripts/day-report.ts",
    "test:extract": "bash pipeline/test_person_context_sql.sh",
    "test:finalcontext": "bash pipeline/test_final_context_sql.sh",
    "data:facts": "python3 -I pipeline/convert_extract.py",
    "test:rebuild": "python3 -I pipeline/test_rebuild_guard.py && python3 -I pipeline/test_convert_extract.py",
    "shards": "python3 -I pipeline/convert_extract.py --layout",
    "data:coverage": "python3 -I pipeline/coverage_matrix.py",
    "data:people": "python3 -I pipeline/people/select_people.py",
    "data:fame": "python3 -I pipeline/people/fame.py rank",
    "data:dump": "python3 -I pipeline/wikidata_dump_people.py",
    "test:dump": "python3 -I pipeline/test_wikidata_dump_people.py",
    "data:golden": "python3 -I pipeline/golden/add_from_dump.py",
    "data:coverage-people": "python3 -I pipeline/coverage_people.py",
    "data:events": "python3 -I pipeline/wikidata_dump_events.py",
    "data:para": "python3 -I pipeline/wikidata_dump_para.py",
    "test:para": "python3 -I pipeline/test_wikidata_dump_para.py",
    "test:events": "python3 -I pipeline/test_wikidata_dump_events.py",
    "data:coverage-events": "python3 -I pipeline/coverage_events.py",
    "data:coverage-tags": "python3 -I pipeline/coverage_tags.py",
    "test:links": "python3 -I pipeline/test_wikidata_links.py",
    "test:dates": "python3 -I pipeline/audit_dates.py && python3 -I pipeline/audit_dates.py --write-disputed data-sources/disputed-dates.json --check",
    "test:disputed": "python3 -I pipeline/test_disputed_dates.py",
    "test:datesrank": "python3 -I pipeline/test_dates_rank.py",
    "test:people": "python3 -I pipeline/people/test_select_people.py && python3 -I pipeline/people/test_fame.py",
    "test:fetchers": "python3 -I pipeline/test_wikimedia.py",
    "data:milestones": "python3 -I pipeline/extract_milestones.py",
    "test:milestones": "python3 -I pipeline/test_milestones.py",
    "site": "pnpm shards && pnpm build && node scripts/site.ts",
    "dev": "pnpm site && node scripts/dev.ts",
    "images": "pnpm site && node scripts/screenshots.ts",
    "animations": "pnpm site && node scripts/animations.ts",
    "images:calendar": "node scripts/calendar-images.ts",
    "images:stamp": "node scripts/images-stamp.ts --write",
    "images:all": "pnpm images:calendar && pnpm images && pnpm animations && pnpm images:showcase && pnpm images:stamp",
    "images:showcase": "pnpm site && node scripts/showcase-images.ts",
    "screenshots": "pnpm images"
  },
  "dependencies": {
    "@johnmorrisdotca/koyomi-calendars": "^0.1.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/dougu-sports": "0.14.0",
    "@johnmorrisdotca/hata": "1.7.2",
    "@johnmorrisdotca/kazoku-ui": "^0.10.0",
    "@johnmorrisdotca/senshu-jerseys": "0.33.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "marked": "^18.1.3",
    "pagefind": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
