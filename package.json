{
  "name": "@johnmorrisdotca/meigen-sports",
  "version": "0.6.7",
  "description": "Meigen Sports \u540d\u8a00, source-verified sports quotations and on-this-day history: typed offline data and pure date, sport and entity selectors, with static JSON feeds. Zero runtime dependencies.",
  "keywords": [
    "sports",
    "quotes",
    "quotations",
    "sports-history",
    "on-this-day",
    "olympics",
    "boxing",
    "wrestling",
    "static-api",
    "open-data",
    "typescript",
    "zero-dependencies",
    "javascript",
    "browser",
    "node",
    "itsutsu"
  ],
  "homepage": "https://johnmorrisdotca.github.io/meigen-sports/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/meigen-sports.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/meigen-sports/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js",
      "default": "./dist/load.js"
    },
    "./quotes": {
      "types": "./dist/data/quotes.d.ts",
      "import": "./dist/data/quotes.js",
      "default": "./dist/data/quotes.js"
    },
    "./offline": {
      "types": "./dist/data/offline.d.ts",
      "import": "./dist/data/offline.js",
      "default": "./dist/data/offline.js"
    },
    "./history": {
      "types": "./dist/data/history.d.ts",
      "import": "./dist/data/history.js",
      "default": "./dist/data/history.js"
    },
    "./package.json": "./package.json",
    "./categories": {
      "types": "./dist/categories.d.ts",
      "import": "./dist/categories.js",
      "default": "./dist/categories.js"
    }
  },
  "files": [
    "dist",
    "data/v1/latest.json",
    "data/v1/0.1.0/all.json",
    "data/v1/0.1.0/history.json",
    "data/v1/0.1.0/quotes.json",
    "data/v1/0.1.0/manifest.json",
    "data/v1/0.1.0/days",
    "data/v1/0.1.0/sports",
    "data/v1/0.1.0/entities",
    "LICENSE",
    "LICENSES",
    "NOTICE.md",
    "CHANGELOG.md",
    "README.md",
    "data-sources/sources.json",
    "data-sources/README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.demo.json",
    "test": "node --test test/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.ts",
    "test:package": "pnpm build && node scripts/check-package.ts",
    "test:golden": "node scripts/check-golden.ts",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "test:demo": "pnpm site && playwright test",
    "prepublishOnly": "pnpm check",
    "family:readme": "node scripts/family-readme.mjs",
    "data": "node scripts/data.ts",
    "data:report": "node scripts/data.ts --report",
    "data:check": "node scripts/data.ts --check",
    "data:days": "node scripts/day-report.ts",
    "test:extract": "bash pipeline/test_person_context_sql.sh",
    "test:finalcontext": "bash pipeline/test_final_context_sql.sh",
    "data:facts": "python3 -I pipeline/convert_extract.py",
    "data:coverage": "python3 -I pipeline/coverage_matrix.py",
    "data:wikidata": "python3 -I pipeline/fetch_wikidata_open.py",
    "data:people": "python3 -I pipeline/people/select_people.py",
    "data:dump": "python3 -I pipeline/wikidata_dump_people.py",
    "test:dump": "python3 -I pipeline/test_wikidata_dump_people.py",
    "data:golden": "python3 -I pipeline/golden/add_from_dump.py",
    "test:people": "python3 -I pipeline/people/test_select_people.py",
    "site": "pnpm build && node scripts/site.ts",
    "dev": "pnpm site && node scripts/dev.ts",
    "images": "pnpm site && node scripts/screenshots.ts",
    "animations": "pnpm site && node scripts/animations.ts",
    "screenshots": "pnpm images"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
